---
import { certifications } from '../data/certifications';
import { translations, type Locale } from '../i18n/translations';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = translations[locale];

const getName = (cert: typeof certifications[0]) => {
  if (locale === 'en') return cert.nameEn ?? cert.name;
  if (locale === 'es') return cert.nameEs ?? cert.name;
  if (locale === 'pt') return cert.namePt ?? cert.name;
  return cert.name;
};

const getMonth = (cert: typeof certifications[0]) => {
  if (locale === 'en') return cert.monthEn;
  if (locale === 'es') return cert.monthEs;
  if (locale === 'pt') return cert.monthPt;
  return cert.month;
};

const academic = certifications.filter((c) => c.type === 'academic');
const technical = certifications.filter((c) => c.type === 'technical');
---

<section id="certifications" class="py-20 bg-gradient-to-br from-slate-900 via-indigo-950 to-slate-900">
  <div class="container mx-auto px-4 sm:px-6 lg:px-8">

    <!-- Cabeceira -->
    <div class="text-center mb-14">
      <h2 class="text-4xl md:text-5xl font-bold mb-4 bg-gradient-to-r from-violet-400 to-cyan-400 bg-clip-text text-transparent">
        {t.certifications.title}
      </h2>
      <p class="text-xl text-slate-400">
        {t.certifications.subtitle}
      </p>
    </div>

    <!-- Técnicas -->
    {technical.length > 0 && (
      <div class="mb-12">
        <div class="flex items-center gap-3 mb-6">
          <span class="text-2xl">🏅</span>
          <h3 class="text-2xl font-bold text-violet-300">{t.certifications.technical}</h3>
          <div class="flex-1 h-px bg-gradient-to-r from-violet-500/50 to-transparent"></div>
        </div>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
          {technical.map((cert, index) => (
            <div
              class="group relative bg-gradient-to-br from-slate-800/80 to-indigo-900/40 border border-indigo-500/30 rounded-2xl p-6 shadow-lg hover:shadow-indigo-500/20 hover:shadow-xl hover:border-indigo-400/60 transition-all duration-300 hover:-translate-y-1 backdrop-blur-sm"
              style={`animation: fadeInUp 0.5s ease-out ${index * 0.1}s both;`}
            >
              <!-- Badge tipo -->
              <div class="absolute top-4 right-4">
                <span class="px-2 py-1 text-xs font-semibold rounded-full bg-indigo-500/20 text-indigo-300 border border-indigo-500/30">
                  {t.certifications.technical}
                </span>
              </div>

              <!-- Icono e nome -->
              <div class="flex items-start gap-4 mb-4">
                <div class="text-4xl flex-shrink-0 mt-1 group-hover:scale-110 transition-transform duration-300">
                  {cert.icon}
                </div>
                <div class="flex-1 pr-20">
                  <h4 class="text-lg font-bold text-white leading-snug mb-1">
                    {getName(cert)}
                  </h4>
                  <p class="text-indigo-300 text-sm font-medium">{cert.issuer}</p>
                </div>
              </div>

              <!-- Metadatos -->
              <div class="flex flex-wrap gap-3 text-xs text-slate-400 mb-4">
                {(cert.month || cert.year) && (
                  <span class="flex items-center gap-1">
                    <svg class="w-3 h-3" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z" />
                    </svg>
                    {getMonth(cert)} {cert.year}
                  </span>
                )}
                {cert.hours && (
                  <span class="flex items-center gap-1">
                    <svg class="w-3 h-3" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" />
                    </svg>
                    {cert.hours}
                  </span>
                )}
                {cert.credentialId && (
                  <span class="flex items-center gap-1 font-mono">
                    <svg class="w-3 h-3" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 7a2 2 0 012 2m4 0a6 6 0 01-7.743 5.743L11 17H9v2H7v2H4a1 1 0 01-1-1v-2.586a1 1 0 01.293-.707l5.964-5.964A6 6 0 1121 9z" />
                    </svg>
                    {cert.credentialId}
                  </span>
                )}
              </div>

              <!-- Botón verificar -->
              {cert.verifyUrl && (
                <a
                  href={cert.verifyUrl}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="inline-flex items-center gap-2 px-4 py-2 text-sm font-semibold rounded-lg bg-indigo-600 hover:bg-indigo-500 text-white transition-colors duration-200"
                >
                  <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" />
                  </svg>
                  {t.certifications.verify}
                </a>
              )}
            </div>
          ))}
        </div>
      </div>
    )}

    <!-- Académicas -->
    {academic.length > 0 && (
      <div>
        <div class="flex items-center gap-3 mb-6">
          <span class="text-2xl">🎓</span>
          <h3 class="text-2xl font-bold text-cyan-300">{t.certifications.academic}</h3>
          <div class="flex-1 h-px bg-gradient-to-r from-cyan-500/50 to-transparent"></div>
        </div>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
          {academic.map((cert, index) => (
            <div
              class="group relative bg-gradient-to-br from-slate-800/80 to-cyan-900/30 border border-cyan-500/30 rounded-2xl p-6 shadow-lg hover:shadow-cyan-500/20 hover:shadow-xl hover:border-cyan-400/60 transition-all duration-300 hover:-translate-y-1 backdrop-blur-sm"
              style={`animation: fadeInUp 0.5s ease-out ${index * 0.1}s both;`}
            >
              <!-- Badge tipo -->
              <div class="absolute top-4 right-4">
                <span class="px-2 py-1 text-xs font-semibold rounded-full bg-cyan-500/20 text-cyan-300 border border-cyan-500/30">
                  {t.certifications.academic}
                </span>
              </div>

              <!-- Icono e nome -->
              <div class="flex items-start gap-4 mb-4">
                <div class="text-4xl flex-shrink-0 mt-1 group-hover:scale-110 transition-transform duration-300">
                  {cert.icon}
                </div>
                <div class="flex-1 pr-20">
                  <h4 class="text-lg font-bold text-white leading-snug mb-1">
                    {getName(cert)}
                  </h4>
                  <p class="text-cyan-300 text-sm font-medium">{cert.issuer}</p>
                </div>
              </div>

              <!-- Metadatos -->
              <div class="flex flex-wrap gap-3 text-xs text-slate-400 mb-4">
                {(cert.month || cert.year) && (
                  <span class="flex items-center gap-1">
                    <svg class="w-3 h-3" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z" />
                    </svg>
                    {getMonth(cert)} {cert.year}
                  </span>
                )}
                {cert.hours && (
                  <span class="flex items-center gap-1">
                    <svg class="w-3 h-3" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" />
                    </svg>
                    {cert.hours}
                  </span>
                )}
                {cert.credentialId && (
                  <span class="flex items-center gap-1 font-mono">
                    <svg class="w-3 h-3" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 7a2 2 0 012 2m4 0a6 6 0 01-7.743 5.743L11 17H9v2H7v2H4a1 1 0 01-1-1v-2.586a1 1 0 01.293-.707l5.964-5.964A6 6 0 1121 9z" />
                    </svg>
                    {cert.credentialId}
                  </span>
                )}
              </div>

              {cert.verifyUrl && (
                <a
                  href={cert.verifyUrl}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="inline-flex items-center gap-2 px-4 py-2 text-sm font-semibold rounded-lg bg-cyan-600 hover:bg-cyan-500 text-white transition-colors duration-200"
                >
                  <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" />
                  </svg>
                  {t.certifications.verify}
                </a>
              )}
            </div>
          ))}
        </div>
      </div>
    )}

  </div>
</section>

<style>
  @keyframes fadeInUp {
    from {
      opacity: 0;
      transform: translateY(24px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }
</style>
